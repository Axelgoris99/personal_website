test.goris.live {
    respond "it works"
}

goddle.goris.live {
    redir https://goddle.xyz permanent
}

blog.goris.live {
    root * /home/debian/blog
    file_server
    encode gzip zstd
}

goris.live {
    root * /home/debian/goris.live
    file_server
    encode gzip zstd

    # Astro fingerprints these files, so they never change under the same name
    header /_astro/* Cache-Control "public, max-age=31536000, immutable"

    handle_errors 404 {
        rewrite * /404.html
        file_server
    }

    log {
        output file /var/log/caddy/access.log
    }
}
