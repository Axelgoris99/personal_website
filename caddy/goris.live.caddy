(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "frame-ancestors 'self'"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }
}

test.goris.live {
    respond "it works"
}

goddle.goris.live {
    redir https://goddle.xyz permanent
}

blog.goris.live {
    root * /home/debian/blog
    file_server
    encode gzip zstd
}

goris.live {
    root * /home/debian/goris.live
    file_server
    encode gzip zstd

    import security_headers

    # Astro fingerprints these files, so they never change under the same name
    header /_astro/* Cache-Control "public, max-age=31536000, immutable"

    handle_errors 404 {
        import security_headers
        rewrite * /404.html
        file_server
    }

    log {
        output file /var/log/caddy/access.log
    }
}
