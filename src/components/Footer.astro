---
import Icon from "./Icon.astro";
const currentYear = new Date().getFullYear();
---

<footer>
  <div class="group">
    <p>
      Thanks to <a href="https://astro.build/">Astro</a>
      <Icon icon="rocket-launch" size="1.2em" />
    </p>
    <p>&copy; {currentYear} Axel Goris</p>
  </div>
  <p class="socials">
    <a href="https://github.com/axelgoris99"> GitHub</a>
  </p>
</footer>
<style>
  /* ===== Normal style ===== */

  :global(html:not(.comic)) footer {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    margin-top: auto;
    padding: 3rem 2rem 3rem;
    text-align: center;
    color: var(--gray-400);
    font-size: var(--text-sm);
  }

  :global(html:not(.comic)) footer a {
    color: var(--gray-400);
    text-decoration: 1px solid underline transparent;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--theme-transition);
  }

  :global(html:not(.comic)) footer a:hover,
  :global(html:not(.comic)) footer a:focus {
    text-decoration-color: currentColor;
  }

  :global(html:not(.comic)) .group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  :global(html:not(.comic)) .socials {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (min-width: 50em) {
    :global(html:not(.comic)) footer {
      flex-direction: row;
      justify-content: space-between;
      padding: 2.5rem 5rem;
    }

    :global(html:not(.comic)) .group {
      flex-direction: row;
      gap: 1rem;
      flex-wrap: wrap;
    }

    :global(html:not(.comic)) .socials {
      justify-content: flex-end;
    }
  }

  /* ===== Comic style ===== */

  :global(html.comic) footer {
    background: var(--panel);
    display: flex;
    flex-direction: column;
    gap: 3rem;
    margin-top: auto;
    padding: 3rem 2rem 3rem;
    text-align: center;
    color: var(--gray-400);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  :global(html.comic) footer a {
    color: var(--gray-400);
    text-decoration: 2px solid underline transparent;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--theme-transition);
  }

  :global(html.comic) footer a:hover,
  :global(html.comic) footer a:focus {
    text-decoration-color: currentColor;
  }

  :global(html.comic) .group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  :global(html.comic) .socials {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (min-width: 50em) {
    :global(html.comic) footer {
      flex-direction: row;
      justify-content: space-between;
      padding: 2.5rem 5rem;
    }

    :global(html.comic) .group {
      flex-direction: row;
      gap: 1rem;
      flex-wrap: wrap;
    }

    :global(html.comic) .socials {
      justify-content: flex-end;
    }
  }

</style>
