---
import type { CollectionEntry } from "astro:content";
import Pill from "./Pill.astro";

interface Props {
  education: CollectionEntry<"education">;
}

const { data, id: slug } = Astro.props.education;
---

<div class="education">
  <a href={`/education/${slug}`}>
    <h3 class="title">{data.title}</h3>
  </a>
  <span class="dateLocation"
    >{data.beginYear.getFullYear()} - {data.endYear.getFullYear()} | {
      data.location
    }</span
  >
  <p class="description">{data.description}</p>
  <div class="tags">
    {data.tags.map((tag) => <Pill>{tag}</Pill>)}
  </div>
</div>
<style>
  /* ===== Normal style ===== */

  :global(html:not(.comic)) .title {
    font-size: var(--text-lg);
    color: var(--gray-0);
  }
  :global(html:not(.comic)) .dateLocation {
    font-size: var(--text-base);
    color: var(--gray-2);
    padding-left: 2rem;
  }
  :global(html:not(.comic)) .tags {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    text-indent: 0px;
  }
  @media (min-width: 50em) {
  :global(html:not(.comic)) .education {
    margin-bottom: 2rem;
  }
  }

  /* ===== Comic style ===== */

  :global(html.comic) .title {
    font-size: var(--text-lg);
    color: var(--gray-0);
  }
  :global(html.comic) .dateLocation {
    font-size: var(--text-base);
    color: var(--gray-400);
    padding-left: 2rem;
  }
  :global(html.comic) .tags {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    text-indent: 0px;
  }
  :global(html.comic) .education {
    position: relative;
    margin-bottom: 2rem;
    padding: 1.25rem 1.5rem;
    background: var(--panel);
    border: var(--border);
    box-shadow: var(--pop);
    text-indent: 0;
  }
  :global(html.comic) .education a {
    text-decoration: none;
  }
  :global(html.comic) .education a:hover .title {
    color: var(--magenta);
  }

</style>
