---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  projects: CollectionEntry<"render">[];
  folder: string;
}

const projects = Astro.props.projects;
const folder = Astro.props.folder;
---

<div class="render-gallery">
  {
    projects.map((project) => (
      <a class="card" href={`/${folder}/${project.id}`}>
        <span class="card-title">{project.data.title}</span>
        {project.data.favorite && <span class="card-favorite">❤️</span>}
        <span class="card-count">{(project.data.imgs && project.data.imgs.length + 1 ) || 1}</span>
        {project.data.video && <span class="card-video">🎥</span>}
        <Image
          src={project.data.img}
          alt={project.data.img_alt || ""}
          style={`view-transition-name: img-${folder}-${project.id}`}
          widths={[480, 960]}
          sizes="(min-width: 50em) 50vw, 100vw"
        />
      </a>
    ))
  }
</div>

<style>
  .render-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(400px, 100%), 1fr));
    grid-gap: 1rem;
    grid-auto-flow: dense;
  }

  .card {
    display: grid;
    grid-template: auto 1fr / auto 1fr;
    background: var(--surface);
    border: var(--line);
    border-radius: var(--radius-sm);
    overflow: hidden;
    text-decoration: none;
    font-family: var(--font-brand);
    font-size: var(--text-lg);
    font-weight: 500;
    text-transform: var(--heading-case);
    letter-spacing: var(--heading-tracking);
    transition:
      box-shadow var(--ui-transition),
      transform var(--ui-transition);
    position: relative;
    box-shadow: inset 0px 0px 100px 100px #DBA632;
  }
  img {
    grid-area: 1 / 1 / 3 / 3;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card:hover {
    box-shadow: var(--shadow-md);
  }

  .card-favorite {
    z-index: 1;
    position: absolute;
    bottom: 0.5rem;
    left: 0.5rem;
    margin: 0.1rem;
    padding: 0.1rem 0.2rem;
    background: var(--label-bg);
    color: var(--label-fg);
    border-radius: var(--radius-xs);
    transition: transform 0.3s ease-in-out;
  }
  .card-favorite:hover {
    transform: scale(1.2);
  }

  .card-count {
    z-index: 1;
    position: absolute;
    bottom: 0.5rem;
    right: 0.5rem;
    margin: 0.1rem;
    padding: 0.1rem 0.5rem;
    background: var(--badge-bg);
    color: var(--badge-fg);
    border-radius: var(--radius-xs);
    font-family: var(--font-label);
    transition: transform 0.3s ease-in-out;
  }
  .card-count:hover {
    transform: scale(1.2);
  }
  .card-video {
    z-index: 1;
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    margin: 0.1rem;
    padding: 0.1rem 0.5rem;
    background: var(--label-bg);
    color: var(--label-fg);
    border-radius: var(--radius-xs);
    transition: transform 0.3s ease-in-out;
  }

  .card-title {
    grid-area: 1 / 1 / 2 / 2;
    z-index: 1;
    margin: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--label-bg);
    color: var(--label-fg);
    border-radius: var(--radius-xs);
  }

  @media (min-width: 50em) {
    .card {
      border-radius: var(--radius-lg);
    }

    .card-title,
    .card-favorite {
      border-radius: var(--radius-md);
    }
  }
</style>
