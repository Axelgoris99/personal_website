---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  projects: CollectionEntry<"render">[];
  folder: string;
}

const projects = Astro.props.projects;
const folder = Astro.props.folder;
---

<div class="gallery">
  {
    projects.map((project) => (
      <a class="card" href={`/${folder}/${project.id}`}>
        <span class="title">{project.data.title}</span>
        {project.data.favorite && <span class="favorite">❤️</span>}
        <span class="number">{(project.data.imgs && project.data.imgs.length + 1 ) || 1}</span>
        {project.data.video && <span class="video">🎥</span>}
        <Image
          src={project.data.img}
          alt={project.data.img_alt || ""}
          style={`view-transition-name: img-${folder}-${project.id}`}
          widths={[480, 960]}
          sizes="(min-width: 50em) 50vw, 100vw"
        />
      </a>
    ))
  }
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(400px, 100%), 1fr));
    gap: 1.75rem;
    grid-auto-flow: dense;
  }

  .card {
    display: grid;
    grid-template: auto 1fr / auto 1fr;
    background: var(--panel);
    border: var(--border);
    overflow: hidden;
    text-decoration: none;
    font-family: var(--font-brand);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: var(--text-lg);
    position: relative;
    box-shadow: var(--pop);
    transition:
      transform var(--snap),
      box-shadow var(--snap);
  }

  /* Alternate panel tilt, like a page of mismatched frames. */
  .card:nth-child(even) {
    transform: rotate(0.6deg);
  }
  .card:nth-child(3n) {
    transform: rotate(-0.8deg);
  }

  .card:hover,
  .card:focus-visible {
    transform: translate(-4px, -4px) rotate(-1deg);
    box-shadow: var(--pop-lg);
  }

  img {
    grid-area: 1 / 1 / 3 / 3;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .favorite,
  .number,
  .video {
    position: absolute;
    z-index: 1;
    padding: 0.1rem 0.5rem;
    background: var(--panel);
    color: var(--gray-0);
    border: var(--border-thin);
    transition: transform var(--snap);
  }

  .favorite {
    bottom: 0.6rem;
    left: 0.6rem;
  }

  .number {
    bottom: 0.6rem;
    right: 0.6rem;
    background: var(--cyan);
    color: var(--on-accent);
    font-family: var(--font-sticker);
    letter-spacing: 0.06em;
  }

  .video {
    top: 0.6rem;
    right: 0.6rem;
  }

  .favorite:hover,
  .number:hover {
    transform: scale(1.2) rotate(-6deg);
  }

  .title {
    grid-area: 1 / 1 / 2 / 2;
    z-index: 1;
    margin: 0.6rem;
    padding: 0.3rem 0.8rem;
    background: var(--yellow);
    color: var(--on-accent);
    border: var(--border-thin);
    box-shadow: var(--pop-sm);
  }
</style>
