---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  projects: CollectionEntry<"render">[];
  folder: string;
}

const projects = Astro.props.projects;
const folder = Astro.props.folder;
---

<div class="gallery">
  {
    projects.map((project) => (
      <a class="card" href={`/${folder}/${project.id}`}>
        <span class="title">{project.data.title}</span>
        {project.data.favorite && <span class="favorite">❤️</span>}
        <span class="number">{(project.data.imgs && project.data.imgs.length + 1 ) || 1}</span>
        {project.data.video && <span class="video">🎥</span>}
        <Image
          src={project.data.img}
          alt={project.data.img_alt || ""}
          style={`view-transition-name: img-${folder}-${project.id}`}
          widths={[480, 960]}
          sizes="(min-width: 50em) 50vw, 100vw"
        />
      </a>
    ))
  }
</div>

<style>
  /* ===== Normal style ===== */

  :global(html:not(.comic)) .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    grid-gap: 1rem;
    grid-auto-flow: dense;
  }

  :global(html:not(.comic)) .card {
    display: grid;
    grid-template: auto 1fr / auto 1fr;
    background: var(--gradient-subtle);
    border: 1px solid var(--gray-800);
    border-radius: 0.75rem;
    overflow: hidden;
    text-decoration: none;
    font-family: var(--font-brand);
    font-size: var(--text-lg);
    font-weight: 500;
    transition: box-shadow var(--theme-transition);
    position: relative;
    box-shadow: inset 0px 0px 100px 100px #DBA632;
  }
  :global(html:not(.comic)) img {
    grid-area: 1 / 1 / 3 / 3;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  :global(html:not(.comic)) .card:hover {
    box-shadow: var(--shadow-md);
  }

  :global(html:not(.comic)) .favorite {
    position: absolute;
    bottom: 0.5rem;
    left: 0.5rem;
    margin: 0.1rem;
    padding: 0.1rem 0.2rem;
    background: var(--gray-999);
    color: var(--gray-200);
    border-radius: 0.375rem;
    transition: transform 0.3s ease-in-out;
  }
  :global(html:not(.comic)) .favorite:hover {
    transform: scale(1.2);
  }

  :global(html:not(.comic)) .number {
    position: absolute;
    bottom: 0.5rem;
    right: 0.5rem;
    margin: 0.1rem;
    padding: 0.1rem 0.5rem;
    background: var(--gray-999);
    color: var(--gray-200);
    border-radius: 0.375rem;
    transition: transform 0.3s ease-in-out;
  }
  :global(html:not(.comic)) .number:hover {
    transform: scale(1.2);
  }
  :global(html:not(.comic)) .video {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    margin: 0.1rem;
    padding: 0.1rem 0.5rem;
    background: var(--gray-999);
    color: var(--gray-200);
    border-radius: 0.375rem;
    transition: transform 0.3s ease-in-out;
  }
  
  :global(html:not(.comic)) .title {
    grid-area: 1 / 1 / 2 / 2;
    z-index: 1;
    margin: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--gray-999);
    color: var(--gray-200);
    border-radius: 0.375rem;
  }

  @media (min-width: 50em) {
    :global(html:not(.comic)) .card {
      border-radius: 1.5rem;
    }

    :global(html:not(.comic)) .title {
      border-radius: 0.9375rem;
    }
    
    :global(html:not(.comic)) .favorite {
      border-radius: 0.9375rem;
    }
  }

  /* ===== Comic style ===== */

  :global(html.comic) .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(400px, 100%), 1fr));
    gap: 1.75rem;
    grid-auto-flow: dense;
  }

  :global(html.comic) .card {
    display: grid;
    grid-template: auto 1fr / auto 1fr;
    background: var(--panel);
    border: var(--border);
    overflow: hidden;
    text-decoration: none;
    font-family: var(--font-brand);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: var(--text-lg);
    position: relative;
    box-shadow: var(--pop);
    transition:
      transform var(--snap),
      box-shadow var(--snap);
  }

  /* Alternate panel tilt, like a page of mismatched frames. */
  :global(html.comic) .card:nth-child(even) {
    transform: rotate(0.6deg);
  }
  :global(html.comic) .card:nth-child(3n) {
    transform: rotate(-0.8deg);
  }

  :global(html.comic) .card:hover,
  :global(html.comic) .card:focus-visible {
    transform: translate(-4px, -4px) rotate(-1deg);
    box-shadow: var(--pop-lg);
  }

  :global(html.comic) img {
    grid-area: 1 / 1 / 3 / 3;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(html.comic) .favorite,
  :global(html.comic) .number,
  :global(html.comic) .video {
    position: absolute;
    z-index: 1;
    padding: 0.1rem 0.5rem;
    background: var(--panel);
    color: var(--gray-0);
    border: var(--border-thin);
    transition: transform var(--snap);
  }

  :global(html.comic) .favorite {
    bottom: 0.6rem;
    left: 0.6rem;
  }

  :global(html.comic) .number {
    bottom: 0.6rem;
    right: 0.6rem;
    background: var(--cyan);
    color: var(--on-accent);
    font-family: var(--font-sticker);
    letter-spacing: 0.06em;
  }

  :global(html.comic) .video {
    top: 0.6rem;
    right: 0.6rem;
  }

  :global(html.comic) .favorite:hover,
  :global(html.comic) .number:hover {
    transform: scale(1.2) rotate(-6deg);
  }

  :global(html.comic) .title {
    grid-area: 1 / 1 / 2 / 2;
    z-index: 1;
    margin: 0.6rem;
    padding: 0.3rem 0.8rem;
    background: var(--yellow);
    color: var(--on-accent);
    border: var(--border-thin);
    box-shadow: var(--pop-sm);
  }

</style>
