---
import CallToAction from "./CallToAction.astro";
import Icon from "./Icon.astro";
---

<aside>
  <h2 class="misprint">Interested in working together?</h2>
  <CallToAction href="mailto:agoriswork@gmail.com">
    Get In Touch!
    <Icon icon="paper-plane-tilt" size="1.2em" />
  </CallToAction>
</aside>

<style>
  /* ===== Normal style ===== */

  :global(html:not(.comic)) aside {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
    border-top: 1px solid var(--gray-800);
    border-bottom: 1px solid var(--gray-800);
    padding: 5rem 1.5rem;
    background-color: var(--gray-999_40);
    box-shadow: var(--shadow-sm);
  }

  :global(html:not(.comic)) h2 {
    font-size: var(--text-xl);
    text-align: center;
    max-width: 15ch;
  }

  @media (min-width: 50em) {
    :global(html:not(.comic)) aside {
      padding: 7.5rem;
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: space-between;
    }

    :global(html:not(.comic)) h2 {
      font-size: var(--text-3xl);
      text-align: left;
    }
  }

  /* ===== Comic style ===== */

  :global(html.comic) aside {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
    padding: 5rem 1.5rem;
    border-block: var(--border);
    background: var(--yellow);
    color: var(--on-accent);
    overflow: hidden;
    isolation: isolate;
  }

  /* Speed lines radiating from the button. */
  :global(html.comic) aside::before {
    content: "";
    position: absolute;
    inset: -50%;
    z-index: -1;
    background: repeating-conic-gradient(
      from 0deg at 70% 50%,
      rgba(255, 255, 255, 0.55) 0deg 4deg,
      transparent 4deg 12deg
    );
  }

  :global(html.comic) h2 {
    font-size: var(--text-3xl);
    text-align: center;
    max-width: 15ch;
    color: var(--on-accent);
  }

  @media (min-width: 50em) {
    :global(html.comic) aside {
      padding: 7.5rem;
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: space-between;
    }

    :global(html.comic) h2 {
      font-size: var(--text-5xl);
      text-align: left;
    }
  }

</style>
