---
import Icon from "./Icon.astro";
---

<button id="topBtn" class="toTop" aria-label="Back to top"><Icon icon="up" size="1.33em" /></button>

<script>
  // Get the button:
  const backToTop = document.getElementById("topBtn");

  backToTop?.addEventListener("click", topFunction);

  // When the user scrolls down 20px from the top of the document, show the button
  addEventListener("scroll", scrollFunction, { passive: true });
  scrollFunction();

  function scrollFunction() {
    if (!backToTop) return;
    if (scrollY > 20) {
      backToTop.style.display = "flex";
    } else {
      backToTop.style.display = "none";
    }
  }

  // When the user clicks on the button, scroll to the top of the document
  function topFunction() {
    scrollTo({ top: 0, behavior: "smooth" });
  }
</script>

<style>
  /* ===== Normal style ===== */

  :global(html:not(.comic)) .toTop {
    position: fixed;
    bottom: 20px;
    right: 30px;
    z-index: 99;
    border: none;
    outline: none;
    background-color: var(--color-bg);
    color: var(--color-text);
    cursor: pointer;
    padding: 15px;
    border-radius: 10px;
  }

  /* ===== Comic style ===== */

  :global(html.comic) .toTop {
    position: fixed;
    bottom: 20px;
    right: 30px;
    z-index: 99;
    display: flex;
    border: var(--border);
    background-color: var(--yellow);
    color: var(--on-accent);
    cursor: pointer;
    padding: 12px;
    box-shadow: var(--pop-sm);
    transition: transform var(--snap), box-shadow var(--snap);
  }

  :global(html.comic) .toTop:hover {
    transform: translate(-2px, -2px) rotate(-6deg);
    box-shadow: var(--pop);
  }

</style>
