---
interface Props {
  title: string;
  tagline?: string;
  align?: "start" | "center";
}

const { align = "center", tagline, title } = Astro.props;
---

<div class:list={["hero stack gap-4", align]}>
  <div class="stack gap-2">
    <h1 class="title misprint">{title}</h1>
    {tagline && <p class="tagline"><span>{tagline}</span></p>}
  </div>
  <slot />
</div>

<style>
  .hero {
    font-size: var(--text-lg);
    text-align: center;
  }

  .title,
  .tagline {
    max-width: 37ch;
    margin-inline: auto;
  }

  .title {
    font-size: var(--text-4xl);
    line-height: 0.95;
    color: var(--gray-0);
  }

  /* Tagline as a comic narration box. */
  .tagline span {
    display: inline;
    padding: 0.15em 0.5em;
    line-height: 1.9;
    color: var(--on-accent);
    background: var(--yellow);
    border: var(--border-thin);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  @media (min-width: 50em) {
    .hero {
      font-size: var(--text-xl);
    }

    .start {
      text-align: start;
    }

    .start .title,
    .start .tagline {
      margin-inline: unset;
    }

    .title {
      font-size: calc(var(--text-5xl) * 1.25);
    }
  }
</style>
