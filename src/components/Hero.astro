---
interface Props {
  title: string;
  tagline?: string;
  align?: "start" | "center";
}

const { align = "center", tagline, title } = Astro.props;
---

<div class:list={["hero stack gap-4", align]}>
  <div class="stack gap-2">
    <h1 class="hero-title">{title}</h1>
    {tagline && <p class="hero-tagline"><span>{tagline}</span></p>}
  </div>
  <slot />
</div>

<style>
  .hero {
    font-size: var(--text-lg);
    text-align: center;
  }

  .hero-title,
  .hero-tagline {
    max-width: 37ch;
    margin-inline: auto;
  }

  .hero-title {
    font-size: var(--text-3xl);
    color: var(--gray-0);
  }

  @media (min-width: 50em) {
    .hero {
      font-size: var(--text-xl);
    }

    .start {
      text-align: start;
    }

    .start .hero-title,
    .start .hero-tagline {
      margin-inline: unset;
    }

    .hero-title {
      font-size: var(--text-5xl);
    }
  }
</style>
