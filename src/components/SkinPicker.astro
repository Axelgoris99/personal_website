---
import { skins } from "../skins";
---

<skin-picker>
  <button class="skin-button" popovertarget="skin-menu" title="Change style">
    <span class="sr-only">Change style</span>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path
        class="palette"
        d="M12 3a9 9 0 0 0 0 18c1.1 0 1.8-.8 1.8-1.7 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.2 0-.9.8-1.7 1.7-1.7H16a5 5 0 0 0 5-5c0-4-4-7.2-9-7.2z"
      ></path>
      <circle cx="7.5" cy="11.5" r="1.4"></circle>
      <circle cx="10" cy="7.5" r="1.4"></circle>
      <circle cx="14.5" cy="7.5" r="1.4"></circle>
      <circle cx="17" cy="11" r="1.4"></circle>
    </svg>
  </button>
  <div id="skin-menu" class="skin-menu" popover>
    <ul>
      {
        skins.map(({ id, label, intro }) => (
          <li>
            <button class="skin-option" data-skin-id={id} data-intro={intro}>
              {label}
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</skin-picker>

<style>
  .skin-button {
    display: flex;
    padding: 0.5rem;
    border: 0;
    border-radius: var(--radius-pill);
    color: var(--accent-regular);
    background-color: var(--gray-999);
    box-shadow: inset 0 0 0 1px var(--accent-overlay);
    cursor: pointer;
    transition:
      color var(--ui-transition),
      background-color var(--ui-transition);
  }

  .skin-button:hover,
  .skin-button:focus-visible {
    color: var(--accent-text-over);
    background-color: var(--accent-regular);
  }

  svg {
    width: 1rem;
    height: 1rem;
    fill: currentColor;
  }

  .palette {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }

  /* Popovers default to the centre of the viewport; JS anchors it to the button. */
  .skin-menu {
    position: fixed;
    inset: auto;
    margin: 0;
    padding: 0.4rem;
    min-width: 9rem;
    color: var(--gray-200);
    background: var(--gray-999);
    border: var(--line);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-lg);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skin-option {
    width: 100%;
    padding: 0.45rem 0.8rem;
    border: 0;
    border-radius: var(--radius-xs);
    font: inherit;
    font-family: var(--font-label);
    text-align: start;
    color: inherit;
    background: none;
    cursor: pointer;
  }

  .skin-option:hover,
  .skin-option:focus-visible {
    background: var(--nav-hover-bg);
  }

  .skin-option[aria-pressed="true"] {
    color: var(--nav-active-fg);
    background: var(--nav-active-bg);
  }
</style>

<script>
  class SkinPicker extends HTMLElement {
    constructor() {
      super();

      const root = document.documentElement;
      const button = this.querySelector<HTMLButtonElement>(".skin-button")!;
      const menu = this.querySelector<HTMLElement>(".skin-menu")!;
      const options = [...this.querySelectorAll<HTMLButtonElement>(".skin-option")];

      const sync = () => {
        for (const option of options) {
          option.setAttribute("aria-pressed", String(option.dataset.skinId === root.dataset.skin));
        }
      };

      const apply = (id: string) => {
        root.dataset.skin = id;
        try {
          localStorage.setItem("skin", id);
        } catch {}
        sync();
      };

      // Anchor the menu under the button.
      menu.addEventListener("toggle", (e) => {
        if ((e as ToggleEvent).newState !== "open") return;
        const rect = button.getBoundingClientRect();
        menu.style.top = `${rect.bottom + 8}px`;
        menu.style.right = `${Math.max(8, innerWidth - rect.right)}px`;
      });

      for (const option of options) {
        option.addEventListener("click", () => {
          const id = option.dataset.skinId!;
          menu.hidePopover();
          if (id === root.dataset.skin) return;

          const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
          if (!document.startViewTransition || reduced) return apply(id);

          // The new skin is revealed from the button (see global.css).
          const rect = button.getBoundingClientRect();
          root.style.setProperty("--switch-x", `${rect.left + rect.width / 2}px`);
          root.style.setProperty("--switch-y", `${rect.top + rect.height / 2}px`);
          root.dataset.skinSwitching = "";

          const transition = document.startViewTransition(() => {
            apply(id);
            const text = option.dataset.intro;
            if (!text) return;
            const intro = document.createElement("div");
            intro.className = "skin-intro";
            intro.textContent = text;
            intro.setAttribute("aria-hidden", "true");
            const remove = () => intro.remove();
            intro.addEventListener("animationend", remove);
            setTimeout(remove, 2000);
            document.body.append(intro);
          });
          // Rejects when the browser skips the animation; the skin still applies.
          transition.ready.catch(() => {});
          transition.finished.finally(() => delete root.dataset.skinSwitching);
        });
      }

      sync();
    }
  }
  customElements.define("skin-picker", SkinPicker);
</script>
