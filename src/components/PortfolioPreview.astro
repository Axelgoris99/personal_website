---
import { Image } from "astro:assets";

import { formatYears } from "../utils/dates";

interface Props {
  project: any;
  folder: string;
}

const { data, id: slug } = Astro.props.project;
const folder = Astro.props.folder;
---

<a class="card" href={`/${folder}/${slug}`}>
  <span class="card-title">{data.title}</span>
  {data.favorite && <span class="card-favorite">❤️</span>}
  {data.begin && <span class="card-dates">{formatYears(data.begin, data.end)}</span>}
  {
    data.img && (
      <Image
        src={data.img}
        alt={data.img_alt || ""}
        style={`view-transition-name: img-${folder}-${slug}`}
        widths={[400, 800]}
        sizes="(min-width: 50em) 50vw, 100vw"
      />
    )
  }
</a>

<style>
  .card {
    display: grid;
    grid-template: auto 1fr / auto 1fr;
    height: 11rem;
    background: var(--surface);
    border: var(--line);
    border-radius: var(--radius-sm);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    font-family: var(--font-brand);
    font-size: var(--text-lg);
    font-weight: 500;
    text-transform: var(--heading-case);
    letter-spacing: var(--heading-tracking);
    transition:
      box-shadow var(--ui-transition),
      transform var(--ui-transition);
    position: relative;
  }

  .card:hover {
    box-shadow: var(--shadow-md);
  }

  .card-title {
    grid-area: 1 / 1 / 2 / 2;
    z-index: 1;
    margin: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--label-bg);
    color: var(--label-fg);
    border-radius: var(--radius-xs);
  }
  .card-favorite {
    z-index: 1;
    position: absolute;
    bottom: 0.5rem;
    left: 0.5rem;
    margin: 0.1rem;
    padding: 0.1rem 0.2rem;
    background: var(--label-bg);
    color: var(--label-fg);
    border-radius: var(--radius-xs);
    transition: transform 0.3s ease-in-out;
  }
  .card-dates {
    position: absolute;
    z-index: 1;
    bottom: 0.5rem;
    right: 0.5rem;
    padding: 0.1rem 0.6rem;
    background: var(--badge-bg);
    color: var(--badge-fg);
    border-radius: var(--radius-xs);
    font-family: var(--font-label);
    font-size: var(--text-sm);
  }
  .card-favorite:hover {
    transform: scale(1.2);
  }

  img {
    grid-area: 1 / 1 / 3 / 3;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform var(--ui-transition),
      filter var(--ui-transition);
  }

  @media (min-width: 50em) {
    .card {
      height: 22rem;
      border-radius: var(--radius-lg);
    }

    .card-title,
    .card-favorite,
    .card-dates {
      border-radius: var(--radius-md);
    }
  }
</style>
