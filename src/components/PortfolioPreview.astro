---
import { Image } from "astro:assets";

import { formatYears } from "../utils/dates";

interface Props {
  project: any;
  folder: string;
}

const { data, id: slug } = Astro.props.project;
const folder = Astro.props.folder;
---

<a class="card" href={`/${folder}/${slug}`}>
  <span class="title">{data.title}</span>
  {data.favorite && <span class="favorite">❤️</span>}
  {data.begin && <span class="dates">{formatYears(data.begin, data.end)}</span>}
  {
    data.img && (
      <Image
        src={data.img}
        alt={data.img_alt || ""}
        style={`view-transition-name: img-${folder}-${slug}`}
        widths={[400, 800]}
        sizes="(min-width: 50em) 50vw, 100vw"
      />
    )
  }
</a>

<style>
  /* ===== Normal style ===== */

  :global(html:not(.comic)) .card {
    display: grid;
    grid-template: auto 1fr / auto 1fr;
    height: 11rem;
    background: var(--gradient-subtle);
    border: 1px solid var(--gray-800);
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    font-family: var(--font-brand);
    font-size: var(--text-lg);
    font-weight: 500;
    transition: box-shadow var(--theme-transition);
    position: relative;
  }

  :global(html:not(.comic)) .card:hover {
    box-shadow: var(--shadow-md);
  }

  :global(html:not(.comic)) .title {
    grid-area: 1 / 1 / 2 / 2;
    z-index: 1;
    margin: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--gray-999);
    color: var(--gray-200);
    border-radius: 0.375rem;
  }
  :global(html:not(.comic)) .favorite {
    position: absolute;
    bottom: 0.5rem;
    left: 0.5rem;
    margin: 0.1rem;
    padding: 0.1rem 0.2rem;
    background: var(--gray-999);
    color: var(--gray-200);
    border-radius: 0.375rem;
    transition: transform 0.3s ease-in-out;
  }
  :global(html:not(.comic)) .dates {
    position: absolute;
    z-index: 1;
    bottom: 0.5rem;
    right: 0.5rem;
    padding: 0.1rem 0.6rem;
    background: var(--gray-999);
    color: var(--gray-300);
    border-radius: 0.375rem;
    font-size: var(--text-sm);
  }
  :global(html:not(.comic)) .favorite:hover {
    transform: scale(1.2);
  }

  :global(html:not(.comic)) img {
    grid-area: 1 / 1 / 3 / 3;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 50em) {
    :global(html:not(.comic)) .card {
      height: 22rem;
      border-radius: 1.5rem;
    }

    :global(html:not(.comic)) .title {
      border-radius: 0.9375rem;
    }

    :global(html:not(.comic)) .favorite,
  :global(html:not(.comic)) .dates {
      border-radius: 0.9375rem;
    }
  }

  /* ===== Comic style ===== */

  :global(html.comic) .card {
    display: grid;
    grid-template: auto 1fr / auto 1fr;
    height: 11rem;
    background: var(--panel);
    border: var(--border);
    overflow: hidden;
    box-shadow: var(--pop);
    text-decoration: none;
    font-family: var(--font-brand);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: var(--text-lg);
    transition:
      transform var(--snap),
      box-shadow var(--snap);
    position: relative;
  }

  /* Halftone shading over the art, lifted on hover. */
  :global(html.comic) .card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(rgba(20, 18, 26, 0.35) 1.5px, transparent 1.8px) 0 0 / 7px 7px;
    mask-image: linear-gradient(200deg, transparent 35%, #000 100%);
    transition: opacity var(--snap);
  }

  :global(html.comic) .card:hover,
  :global(html.comic) .card:focus-visible {
    transform: translate(-4px, -4px) rotate(-1deg);
    box-shadow: var(--pop-lg);
  }

  :global(html.comic) .card:hover::after,
  :global(html.comic) .card:focus-visible::after {
    opacity: 0;
  }

  :global(html.comic) .title {
    grid-area: 1 / 1 / 2 / 2;
    z-index: 1;
    margin: 0.6rem;
    padding: 0.3rem 0.8rem;
    background: var(--yellow);
    color: var(--on-accent);
    border: var(--border-thin);
    box-shadow: var(--pop-sm);
  }
  :global(html.comic) .favorite {
    position: absolute;
    z-index: 1;
    bottom: 0.6rem;
    left: 0.6rem;
    padding: 0.1rem 0.35rem;
    background: var(--panel);
    border: var(--border-thin);
    transition: transform var(--snap);
  }
  :global(html.comic) .dates {
    position: absolute;
    z-index: 1;
    bottom: 0.6rem;
    right: 0.6rem;
    padding: 0.1rem 0.6rem;
    background: var(--cyan);
    color: var(--on-accent);
    border: var(--border-thin);
    font-family: var(--font-sticker);
    font-size: var(--text-md);
    letter-spacing: 0.06em;
    transform: rotate(-3deg);
  }
  :global(html.comic) .favorite:hover {
    transform: scale(1.3) rotate(10deg);
  }

  :global(html.comic) img {
    grid-area: 1 / 1 / 3 / 3;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--snap);
  }

  :global(html.comic) .card:hover img {
    transform: scale(1.04);
  }

  @media (min-width: 50em) {
    :global(html.comic) .card {
      height: 22rem;
    }

    :global(html.comic) .title {
      font-size: var(--text-xl);
    }
  }

</style>
