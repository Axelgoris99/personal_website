---
import Icon from "./Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";
import ComicToggle from "./ComicToggle.astro";
import type { iconPaths } from "./IconPaths";

/** Main menu items */
const textLinks: { label: string; href: string }[] = [
  { label: "Home", href: "/" },
  { label: "Project", href: "/project/" },
  { label: "Work", href: "/work/" },
  { label: "Render", href: "/render/" },
  { label: "About", href: "/about/" },
];

/** Icon links to social media — edit these with links to your profiles! */
const iconLinks: {
  label: string;
  href: string;
  icon: keyof typeof iconPaths;
}[] = [
  {
    label: "GitHub",
    href: "https://github.com/axelgoris99",
    icon: "github-logo",
  },
  {
    label: "Linkedin",
    href: "https://www.linkedin.com/in/axel-goris",
    icon: "linkedin-logo",
  },
  //{ label: 'Facebook', href: 'https://www.youtube.com/@me/', icon: 'facebook-logo' },
  //{ label: 'YouTube', href: 'https://www.youtube.com/@me/', icon: 'youtube-logo' },
  { label: "Blog", href: "https://blog.goris.live", icon: "blog-logo" },
];
---

<nav>
  <div class="menu-header">
    <a href="/" class="site-title">
      <span class="logo on-beat"
        ><Icon
          icon="terminal-window"
          color="var(--accent-regular)"
          size="1.6em"
          gradient
        /></span
      >
      <span class="misprint">Axel Goris</span>
    </a>
    <menu-button>
      <template>
        <button class="menu-button" aria-expanded="false">
          <span class="sr-only">Menu</span>
          <Icon icon="list" />
        </button>
      </template>
    </menu-button>
  </div>
  <noscript>
    <ul class="nav-items">
      {
        textLinks.map(({ label, href }) => (
          <li>
            <a
              aria-current={Astro.url.pathname === href}
              class:list={[
                "link",
                {
                  active:
                    Astro.url.pathname === href ||
                    (href !== "/" && Astro.url.pathname.startsWith(href)),
                },
              ]}
              href={href}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </noscript>
  <noscript>
    <div class="menu-footer">
      <div class="socials">
        {
          iconLinks.map(({ href, icon, label }) => (
            <a href={href} class="social" target="_blank">
              <span class="sr-only">{label}</span>
              <Icon icon={icon} />
            </a>
          ))
        }
      </div>
    </div>
  </noscript>
  <div id="menu-content" hidden>
    <ul class="nav-items">
      {
        textLinks.map(({ label, href }) => (
          <li>
            <a
              aria-current={Astro.url.pathname === href}
              class:list={[
                "link",
                {
                  active:
                    Astro.url.pathname === href ||
                    (href !== "/" && Astro.url.pathname.startsWith(href)),
                },
              ]}
              href={href}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="menu-footer">
      <div class="socials">
        {
          iconLinks.map(({ href, icon, label }) => (
            <a href={href} class="social" target="_blank">
              <span class="sr-only">{label}</span>
              <Icon icon={icon} />
            </a>
          ))
        }
      </div>

      <div class="theme-toggle">
        <ComicToggle />
        <ThemeToggle />
      </div>
    </div>
  </div>
</nav>

<script>
  class MenuButton extends HTMLElement {
    constructor() {
      super();

      // Inject menu toggle button when JS runs.
      this.appendChild(this.querySelector("template")!.content.cloneNode(true));
      const btn = this.querySelector("button")!;

      // Hide menu (shown by default to support no-JS browsers).
      const menu = document.getElementById("menu-content")!;
      menu.hidden = true;
      // Add "menu-content" class in JS to avoid covering content in non-JS browsers.
      menu.classList.add("menu-content");

      /** Set whether the menu is currently expanded or collapsed. */
      const setExpanded = (expand: boolean) => {
        btn.setAttribute("aria-expanded", expand ? "true" : "false");
        menu.hidden = !expand;
      };

      // Toggle menu visibility when the menu button is clicked.
      btn.addEventListener("click", () => setExpanded(menu.hidden));

      // Hide menu button for large screens.
      const handleViewports = (e: MediaQueryList | MediaQueryListEvent) => {
        setExpanded(e.matches);
        btn.hidden = e.matches;
      };
      const mediaQueries = window.matchMedia("(min-width: 50em)");
      handleViewports(mediaQueries);
      mediaQueries.addEventListener("change", handleViewports);
    }
  }
  customElements.define("menu-button", MenuButton);
</script>

<style>
  .logo {
    display: flex;
  }

  .theme-toggle {
    gap: 0.5rem;
  }

  /* ===== Normal style ===== */

  :global(html:not(.comic)) nav {
    z-index: 9999;
    position: relative;
    font-family: var(--font-brand);
    font-weight: 500;
    margin-bottom: 3.5rem;
  }

  :global(html:not(.comic)) .menu-header {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 1.5rem;
  }

  :global(html:not(.comic)) .site-title {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    line-height: 1.1;
    color: var(--gray-0);
    text-decoration: none;
  }

  :global(html:not(.comic)) .menu-button {
    position: relative;
    display: flex;
    border: 0;
    border-radius: 999rem;
    padding: 0.5rem;
    font-size: 1.5rem;
    color: var(--gray-300);
    background: radial-gradient(var(--gray-900), var(--gray-800) 150%);
    box-shadow: var(--shadow-md);
  }

  :global(html:not(.comic)) .menu-button[aria-expanded="true"] {
    color: var(--gray-0);
    background:
      linear-gradient(180deg, var(--gray-600), transparent),
      radial-gradient(var(--gray-900), var(--gray-800) 150%);
  }

  :global(html:not(.comic)) .menu-button[hidden] {
    display: none;
  }

  :global(html:not(.comic)) .menu-button::before {
    position: absolute;
    inset: -1px;
    content: "";
    background: var(--gradient-stroke);
    border-radius: 999rem;
    z-index: -1;
  }

  :global(html:not(.comic)) .menu-content {
    position: absolute;
    left: 0;
    right: 0;
  }

  :global(html:not(.comic)) .nav-items {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: var(--text-md);
    line-height: 1.2;
    list-style: none;
    padding: 2rem;
    background-color: var(--gray-999);
    border-bottom: 1px solid var(--gray-800);
  }

  :global(html:not(.comic)) .link {
    display: inline-block;
    color: var(--gray-300);
    text-decoration: none;
  }

  :global(html:not(.comic)) .link.active {
    color: var(--gray-0);
  }

  :global(html:not(.comic)) .menu-footer {
    --icon-size: var(--text-xl);
    --icon-padding: 0.5rem;

    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1.5rem 2rem 1.5rem 1.5rem;
    background-color: var(--gray-999);
    border-radius: 0 0 0.75rem 0.75rem;
    box-shadow: var(--shadow-lg);
  }

  :global(html:not(.comic)) .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    font-size: var(--icon-size);
  }

  :global(html:not(.comic)) .social {
    display: flex;
    padding: var(--icon-padding);
    text-decoration: none;
    color: var(--accent-dark);
    transition: color var(--theme-transition);
  }

  :global(html:not(.comic)) .social:hover,
  :global(html:not(.comic)) .social:focus {
    color: var(--accent-text-over);
  }

  :global(html:not(.comic)) .theme-toggle {
    display: flex;
    align-items: center;
    height: calc(var(--icon-size) + 2 * var(--icon-padding));
  }

  @media (min-width: 50em) {
    :global(html:not(.comic)) nav {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      padding: 2.5rem 5rem;
      gap: 1rem;
    }

    :global(html:not(.comic)) .menu-header {
      padding: 0;
    }

    :global(html:not(.comic)) .site-title {
      font-size: var(--text-lg);
    }

    :global(html:not(.comic)) .menu-content {
      display: contents;
    }

    :global(html:not(.comic)) .nav-items {
      position: relative;
      flex-direction: row;
      font-size: var(--text-sm);
      border-radius: 999rem;
      border: 0;
      padding: 0.5rem 0.5625rem;
      background: radial-gradient(var(--gray-900), var(--gray-800) 150%);
      box-shadow: var(--shadow-md);
    }

    :global(html:not(.comic)) .nav-items::before {
      position: absolute;
      inset: -1px;
      content: "";
      background: var(--gradient-stroke);
      border-radius: 999rem;
      z-index: -1;
    }

    :global(html:not(.comic)) .link {
      padding: 0.5rem 1rem;
      border-radius: 999rem;
      transition:
        color var(--theme-transition),
        background-color var(--theme-transition);
    }

    :global(html:not(.comic)) .link:hover,
  :global(html:not(.comic)) .link:focus {
      color: var(--gray-100);
      background-color: var(--accent-subtle-overlay);
    }

    :global(html:not(.comic)) .link.active {
      color: var(--accent-text-over);
      background-color: var(--accent-regular);
    }

    :global(html:not(.comic)) .menu-footer {
      --icon-padding: 0.375rem;

      justify-self: flex-end;
      align-items: center;
      padding: 0;
      background-color: transparent;
      box-shadow: none;
    }

    :global(html:not(.comic)) .socials {
      display: none;
    }
  }

  @media (min-width: 60em) {
    :global(html:not(.comic)) .socials {
      display: flex;
      justify-content: flex-end;
      gap: 0;
    }
  }
  @media (forced-colors: active) {
    :global(html:not(.comic)) .link.active {
      color: SelectedItem;
    }
  }

  /* ===== Comic style ===== */

  :global(html.comic) nav {
    z-index: 9999;
    position: relative;
    font-family: var(--font-brand);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-bottom: 3.5rem;
  }

  :global(html.comic) .menu-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding: 1.5rem;
  }

  :global(html.comic) .site-title {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    line-height: 1.1;
    font-size: var(--text-lg);
    color: var(--gray-0);
    text-decoration: none;
  }

  :global(html.comic) .logo {
    display: flex;
    padding: 0.35rem;
    color: var(--on-accent);
    background: var(--yellow);
    border: var(--border-thin);
    box-shadow: var(--pop-sm);
  }

  :global(html.comic) .logo :global(svg) {
    width: 1.1em;
    height: 1.1em;
    stroke: currentColor;
    fill: currentColor;
  }

  :global(html.comic) .menu-button {
    position: relative;
    display: flex;
    border: var(--border);
    padding: 0.5rem;
    font-size: 1.5rem;
    color: var(--gray-0);
    background: var(--panel);
    box-shadow: var(--pop-sm);
  }

  :global(html.comic) .menu-button[aria-expanded="true"] {
    color: var(--on-accent);
    background: var(--yellow);
  }

  :global(html.comic) .menu-button[hidden] {
    display: none;
  }

  :global(html.comic) .menu-content {
    position: absolute;
    left: 0;
    right: 0;
  }

  :global(html.comic) .nav-items {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: var(--text-xl);
    line-height: 1.2;
    list-style: none;
    padding: 2rem;
    background-color: var(--panel);
    border-block: var(--border);
  }

  :global(html.comic) .link {
    display: inline-block;
    color: var(--gray-300);
    text-decoration: none;
  }

  :global(html.comic) .link.active {
    color: var(--gray-0);
  }

  :global(html.comic) .menu-footer {
    --icon-size: var(--text-xl);
    --icon-padding: 0.5rem;

    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1.5rem 2rem 1.5rem 1.5rem;
    background-color: var(--panel);
    border-bottom: var(--border);
    box-shadow: 0 8px 0 var(--ink-shadow);
  }

  :global(html.comic) .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    font-size: var(--icon-size);
  }

  :global(html.comic) .social {
    display: flex;
    padding: var(--icon-padding);
    text-decoration: none;
    color: var(--gray-0);
    transition: transform var(--snap), color var(--snap);
  }

  :global(html.comic) .social:hover,
  :global(html.comic) .social:focus {
    color: var(--magenta);
    transform: rotate(-8deg) scale(1.15);
  }

  :global(html.comic) .theme-toggle {
    display: flex;
    align-items: center;
    height: calc(var(--icon-size) + 2 * var(--icon-padding));
  }

  @media (min-width: 50em) {
    :global(html.comic) nav {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      padding: 2.5rem 5rem;
      gap: 1rem;
    }

    :global(html.comic) .menu-header {
      padding: 0;
    }

    :global(html.comic) .site-title {
      font-size: var(--text-xl);
    }

    :global(html.comic) .menu-content {
      display: contents;
    }

    :global(html.comic) .nav-items {
      position: relative;
      flex-direction: row;
      gap: 0.25rem;
      font-size: var(--text-md);
      border: var(--border);
      padding: 0.4rem;
      background: var(--panel);
      box-shadow: var(--pop);
      transform: skewX(-8deg);
    }

    :global(html.comic) .link {
      padding: 0.35rem 1rem;
      transition:
        color var(--snap),
        background-color var(--snap),
        transform var(--snap);
    }

    :global(html.comic) .link:hover,
  :global(html.comic) .link:focus {
      color: var(--on-accent);
      background-color: var(--yellow);
      transform: translateY(-2px);
    }

    :global(html.comic) .link.active {
      color: var(--on-accent);
      background-color: var(--magenta);
      box-shadow: inset 0 0 0 2px var(--ink);
    }

    :global(html.comic) .menu-footer {
      --icon-padding: 0.375rem;

      justify-self: flex-end;
      align-items: center;
      padding: 0;
      background-color: transparent;
      border: 0;
      box-shadow: none;
    }

    :global(html.comic) .socials {
      display: none;
    }
  }

  @media (min-width: 60em) {
    :global(html.comic) .socials {
      display: flex;
      justify-content: flex-end;
      gap: 0;
    }
  }
  @media (forced-colors: active) {
    :global(html.comic) .link.active {
      color: SelectedItem;
    }
  }

</style>
