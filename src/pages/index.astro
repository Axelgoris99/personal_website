---
import { Image, getImage } from "astro:assets";
import { getCollection } from "astro:content";
import { byMostRecent } from "../utils/dates";

import portrait from "../assets/portrait.webp";

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Axel Goris",
  url: Astro.site?.href,
  image: new URL(
    (await getImage({ src: portrait, width: 800, format: "jpg" })).src,
    Astro.site
  ).href,
  jobTitle: "Software Engineer",
  worksFor: [
    { "@type": "Organization", name: "Nabla" },
    { "@type": "Organization", name: "GoGoStudio" },
  ],
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "KTH Royal Institute of Technology" },
    { "@type": "CollegeOrUniversity", name: "Ecole Centrale de Nantes" },
  ],
  sameAs: [
    "https://www.linkedin.com/in/axel-goris",
    "https://github.com/axelgoris99",
    "https://axelgoris99.itch.io",
    "https://blog.goris.live",
  ],
};

// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from "../layouts/BaseLayout.astro";

// Component Imports
import CallToAction from "../components/CallToAction.astro";
import Grid from "../components/Grid.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
import Pill from "../components/Pill.astro";
import PortfolioPreview from "../components/PortfolioPreview.astro";

// Page section components
import ContactCTA from "../components/ContactCTA.astro";
import Skills from "../components/Skills.astro";

// Content Fetching: List four most recent work projects
const works = (await getCollection("work"))
  .sort(byMostRecent)
  .slice(0, 4);

const projects = (await getCollection("project"))
  .sort(byMostRecent)
  .slice(0, 6);

// Full Astro Component Syntax:
// https://docs.astro.build/core-concepts/astro-components/
---

<BaseLayout>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(person)}
  />
  <div class="stack gap-20 lg:gap-48">
    <div class="wrapper stack gap-8 lg:gap-20">
      <header class="hero">
        <Hero
          title="Hello There! I'm Axel Goris"
          tagline="I am a Software Engineer. Currently based in France."
          align="start"
        >
          <div class="roles">
            <Pill><Icon icon="code" size="1.33em" /> Engineer</Pill>
            <Pill><Icon icon="microphone-stage" size="1.33em" /> Impro</Pill>
            <Pill><Icon icon="karate" size="1.33em" /> Karate</Pill>
            <Pill><Icon icon="piano" size="1.33em" /> Piano</Pill>
            <Pill><Icon icon="climbing" size="1.33em" /> Climbing</Pill>
          </div>
          <CallToAction
            href="/Axel_Goris_Resume.pdf"
            data-umami-event="Resume download"
            data-umami-event-from="home"
          >
            My Resume
            <Icon icon="arrow-right" size="1.2em" />
          </CallToAction>
        </Hero>

        <div class="portrait">
          <span class="burst on-beat" aria-hidden="true">Hi!</span>
          <Image
          alt="Axel Goris smiling in a winter coat with the swedish parliament in the background"
          src={portrait}
          widths={[480, 960]}
          sizes="(min-width: 50em) 480px, 100vw"
          fetchpriority="high"
          loading="eager"
        />
        </div>
      </header>

      <Skills />
    </div>

    <main class="wrapper stack gap-20 lg:gap-48">
      <section class="section with-background with-cta">
        <header class="section-header stack gap-2 lg:gap-4">
          <h3>Recent Work</h3>
          <p>Take a look below at some of my most recent work.</p>
        </header>

        <div class="gallery">
          <Grid>
            {
              works.map((work) => (
                <li>
                  <PortfolioPreview project={work} folder="work" />
                </li>
              ))
            }
          </Grid>
        </div>

        <div class="cta">
          <CallToAction href="/work/">
            View All
            <Icon icon="arrow-right" size="1.2em" />
          </CallToAction>
        </div>
      </section>

      <section class="section with-background with-cta">
        <header class="section-header stack gap-2 lg:gap-4">
          <h3>Recent Projects</h3>
          <p>Take a look below at some of my most recent personal projects.</p>
        </header>

        <div class="gallery">
          <Grid variant="small">
            {
              projects.map((project) => (
                <li>
                  <PortfolioPreview project={project} folder="project" />
                </li>
              ))
            }
          </Grid>
        </div>

        <div class="cta">
          <CallToAction href="/project/">
            View All
            <Icon icon="arrow-right" size="1.2em" />
          </CallToAction>
        </div>
      </section>

      <section class="section with-background with-cta">
        <header class="section-header stack gap-2 lg:gap-4">
          <h3>Renders</h3>
          <p>
            Not what I do the most but... if you want, you can find some renders
            I did over the years.
          </p>
        </header>

        <div class="cta">
          <CallToAction href="/render/">
            View All
            <Icon icon="arrow-right" size="1.2em" />
          </CallToAction>
        </div>
      </section>

      <!-- <section class="section with-background bg-variant">
				<header class="section-header stack gap-2 lg:gap-4">
					<h3>Mentions</h3>
					<p>
						I have been fortunate enough to receive praise for my work in several publications. Take
						a look below to learn more.
					</p>
				</header>

				<div class="gallery">
					<Grid variant="small">
						{
							['Medium', 'BuzzFeed', 'The Next Web', 'awwwards.', 'TechCrunch'].map((brand) => (
								<li class="mention-card">
									<p>{brand}</p>
								</li>
							))
						}
					</Grid>
				</div>
			</section> -->
    </main>

    <ContactCTA />
  </div>
</BaseLayout>

<style>
  :global(html:not(.comic)) .burst {
    display: none;
  }
  /* ===== Normal style ===== */

  :global(html:not(.comic)) .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  :global(html:not(.comic)) .hero img {
    aspect-ratio: 5 / 4;
    object-fit: cover;
    object-position: top;
    border-radius: 1.5rem;
    box-shadow: var(--shadow-md);
  }

  :global(html:not(.comic)) .roles {
      margin-top: 0.5rem;
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      justify-content: center;
      align-content: center;
   }

  @media (min-width: 50em) {
    :global(html:not(.comic)) .hero {
      display: grid;
      grid-template-columns: 6fr 4fr;
      padding-inline: 2.5rem;
      gap: 3.75rem;
    }

    :global(html:not(.comic)) .hero img {
      aspect-ratio: 3 / 4;
      border-radius: 4.5rem;
      object-fit: cover;
    }
  }

  /* ====================================================== */

  :global(html:not(.comic)) .section {
    display: grid;
    gap: 2rem;
  }

  :global(html:not(.comic)) .with-background {
    position: relative;
  }

  :global(html:not(.comic)) .with-background::before {
    --hero-bg: var(--bg-image-subtle-2);

    content: "";
    position: absolute;
    pointer-events: none;
    left: 50%;
    width: 100vw;
    aspect-ratio: calc(2.25 / var(--bg-scale));
    top: 0;
    transform: translateY(-75%) translateX(-50%);
    background:
      url("/assets/backgrounds/noise.webp") top center/220px repeat,
      var(--hero-bg) center center / var(--bg-gradient-size) no-repeat,
      var(--gray-999);
    background-blend-mode: overlay, normal, normal, normal;
    mix-blend-mode: var(--bg-blend-mode);
    z-index: -1;
  }

  :global(html:not(.comic)) .with-background.bg-variant::before {
    --hero-bg: var(--bg-image-subtle-1);
  }

  :global(html:not(.comic)) .section-header {
    justify-self: center;
    text-align: center;
    max-width: 50ch;
    font-size: var(--text-md);
    color: var(--gray-300);
  }

  :global(html:not(.comic)) .section-header h3 {
    font-size: var(--text-2xl);
  }

  @media (min-width: 50em) {
    :global(html:not(.comic)) .section {
      grid-template-columns: repeat(4, 1fr);
      grid-template-areas: "header header header header" "gallery gallery gallery gallery";
      gap: 5rem;
    }

    :global(html:not(.comic)) .section.with-cta {
      grid-template-areas: "header header header cta" "gallery gallery gallery gallery";
    }

    :global(html:not(.comic)) .section-header {
      grid-area: header;
      font-size: var(--text-lg);
    }

    :global(html:not(.comic)) .section-header h3 {
      font-size: var(--text-4xl);
    }

    :global(html:not(.comic)) .with-cta .section-header {
      justify-self: flex-start;
      text-align: left;
    }

    :global(html:not(.comic)) .gallery {
      grid-area: gallery;
    }

    :global(html:not(.comic)) .cta {
      grid-area: cta;
    }
  }

  /* ====================================================== */

  :global(html:not(.comic)) .mention-card {
    display: flex;
    height: 7rem;
    justify-content: center;
    align-items: center;
    text-align: center;
    border: 1px solid var(--gray-800);
    border-radius: 1.5rem;
    color: var(--gray-300);
    background: var(--gradient-subtle);
    box-shadow: var(--shadow-sm);
  }

  @media (min-width: 50em) {
    :global(html:not(.comic)) .mention-card {
      border-radius: 1.5rem;
      height: 9.5rem;
    }
  }

  /* ===== Comic style ===== */

  :global(html.comic) .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
  }

  :global(html.comic) .portrait {
    position: relative;
    max-width: 30rem;
  }

  /* Portrait as a comic frame with an off-register cyan plate behind it. */
  :global(html.comic) .portrait :global(img) {
    display: block;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    object-position: top;
    border: var(--border);
    box-shadow:
      12px 12px 0 var(--cyan),
      12px 12px 0 3px var(--ink);
    transform: rotate(2deg);
  }

  /* Starburst sticker. */
  :global(html.comic) .burst {
    position: absolute;
    z-index: 1;
    top: -1.5rem;
    left: -1.5rem;
    display: grid;
    place-items: center;
    width: 6rem;
    aspect-ratio: 1;
    font-family: var(--font-sticker);
    font-size: 2rem;
    letter-spacing: 0.05em;
    color: var(--on-accent);
    background: var(--magenta);
    clip-path: polygon(
      50% 0%, 61% 18%, 82% 7%, 79% 30%, 100% 34%, 84% 50%, 100% 66%, 79% 70%,
      82% 93%, 61% 82%, 50% 100%, 39% 82%, 18% 93%, 21% 70%, 0% 66%, 16% 50%,
      0% 34%, 21% 30%, 18% 7%, 39% 18%
    );
  }

  :global(html.comic) .roles {
    margin-top: 0.5rem;
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
    align-content: center;
  }

  @media (min-width: 50em) {
    :global(html.comic) .hero {
      display: grid;
      grid-template-columns: 6fr 4fr;
      padding-inline: 2.5rem;
      gap: 3.75rem;
    }

    :global(html.comic) .roles {
      justify-content: flex-start;
    }

    :global(html.comic) .portrait :global(img) {
      aspect-ratio: 3 / 4;
    }

    :global(html.comic) .burst {
      width: 7.5rem;
      font-size: 2.6rem;
    }
  }

  /* ====================================================== */

  :global(html.comic) .section {
    display: grid;
    gap: 2rem;
  }

  :global(html.comic) .section-header {
    justify-self: center;
    text-align: center;
    max-width: 50ch;
    font-size: var(--text-md);
    color: var(--gray-300);
  }

  /* Section titles sit on a skewed highlighter stroke. */
  :global(html.comic) .section-header h3 {
    justify-self: inherit;
    width: fit-content;
    margin-inline: auto;
    font-size: var(--text-3xl);
    padding: 0 0.3em;
    background: linear-gradient(transparent 55%, var(--magenta) 55%, var(--magenta) 90%, transparent 90%);
  }

  @media (min-width: 50em) {
    :global(html.comic) .section {
      grid-template-columns: repeat(4, 1fr);
      grid-template-areas: "header header header header" "gallery gallery gallery gallery";
      gap: 4rem;
    }

    :global(html.comic) .section.with-cta {
      grid-template-areas: "header header header cta" "gallery gallery gallery gallery";
    }

    :global(html.comic) .section-header {
      grid-area: header;
      font-size: var(--text-lg);
    }

    :global(html.comic) .section-header h3 {
      font-size: var(--text-5xl);
    }

    :global(html.comic) .with-cta .section-header {
      justify-self: flex-start;
      text-align: left;
    }

    :global(html.comic) .with-cta .section-header h3 {
      margin-inline: 0;
    }

    :global(html.comic) .gallery {
      grid-area: gallery;
    }

    :global(html.comic) .cta {
      grid-area: cta;
      align-self: center;
    }
  }

  /* Alternate the highlighter colour per section. */
  :global(html.comic) .section:nth-of-type(2) .section-header h3 {
    background: linear-gradient(transparent 55%, var(--cyan) 55%, var(--cyan) 90%, transparent 90%);
  }
  :global(html.comic) .section:nth-of-type(3) .section-header h3 {
    background: linear-gradient(transparent 55%, var(--yellow) 55%, var(--yellow) 90%, transparent 90%);
  }

</style>
